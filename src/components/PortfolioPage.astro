---
// The whole portfolio page. Both locale routes (/pt/, /en/) render this component, so
// layout and behaviour are always the same; only the content from siteContent.ts differs.
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from './Icon.astro';
import Flag from './Flag.astro';
import { content, languages, type AwardItem, type Locale } from '../lib/siteContent';

type Props = {
	locale: Locale;
};

const { locale } = Astro.props;
const c = content[locale];
const s = c.sections;
const ui = c.ui;

const baseUrl = import.meta.env.BASE_URL;
const currentLanguage = languages.find((lang) => lang.locale === locale)!;
const languageHref = (href: string) => `${baseUrl}${href.replace(/^\//, '')}`;
const nav = [s.about, s.research, s.projects, s.experience, s.education, s.certificates, s.achievements, s.contact];

const assetImages = import.meta.glob<string>('/src/assets/images/**/*.{png,jpg,jpeg,webp,avif,svg}', {
	eager: true,
	query: '?url',
	import: 'default',
});

const toSlug = (value: string) => {
	return value
		.toLowerCase()
		.normalize('NFD')
		.replace(/[̀-ͯ]/g, '')
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/(^-|-$)/g, '')
		.slice(0, 60);
};

const experienceId = (role: string) => `exp-${toSlug(role)}`;

const resolveImageUrl = (relativePath: string) => {
	const clean = relativePath.replace(/^\//, '');
	return assetImages[`/src/assets/images/${clean}`] ?? null;
};

type GalleryImage = { src: string; thumb: string; alt: string };

// Images of a certificate/achievement with their URLs resolved (missing files are skipped).
const galleryOf = (item: AwardItem): GalleryImage[] => {
	const images = item.images ?? (item.image ? [item.image] : []);
	return images.flatMap((img) => {
		const src = resolveImageUrl(img.src);
		return src ? [{ src, thumb: resolveImageUrl(img.thumbSrc ?? img.src) ?? src, alt: img.alt }] : [];
	});
};

// Payload read by scripts/lightbox.ts
const lightboxOf = (gallery: GalleryImage[]) => JSON.stringify(gallery.map(({ src, alt }) => ({ src, alt })));

const isExternal = (href: string) => href.startsWith('http');
---

<BaseLayout title={c.meta.title} description={c.meta.description} lang={locale === 'pt' ? 'pt-BR' : 'en'} canonicalPath={`${locale}/`}>

	<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:rounded-lg focus:bg-indigo-600 focus:px-4 focus:py-2 focus:text-sm focus:font-semibold focus:text-white focus:shadow-lg">
		{ui.skipToContent}
	</a>

	<div class="scroll-progress" id="scroll-progress" aria-hidden="true"></div>

	<!-- ── STICKY NAVBAR ─────────────────────────────────── -->
	<div class="sticky top-0 z-40 border-b border-zinc-200/80 bg-white/85 backdrop-blur-md dark:border-zinc-800/80 dark:bg-zinc-950/85" data-site-nav>
		<div class="mx-auto flex max-w-5xl items-center justify-between gap-2 px-4 py-2.5 sm:px-6 sm:py-3">
			<nav class="flex flex-wrap gap-x-3 gap-y-1 text-xs font-medium text-zinc-600 sm:gap-x-5 sm:text-sm dark:text-zinc-400">
				{nav.map((item) => (
					<a class="link-underline hover:text-indigo-600 dark:hover:text-indigo-400" href={`#${item.id}`}>{item.title}</a>
				))}
			</nav>
			<div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
				<details class="relative" data-language-menu>
					<summary
						class="clickable flex cursor-pointer list-none items-center gap-1.5 rounded-lg border border-zinc-200 px-2 py-1 text-xs font-semibold text-zinc-700 hover:text-indigo-600 dark:border-zinc-700 dark:text-zinc-300 dark:hover:text-indigo-400 [&::-webkit-details-marker]:hidden"
						aria-label={ui.languageSwitchLabel}
					>
						<Flag locale={currentLanguage.locale} class="h-3.5 w-5 rounded-[2px] shadow-sm ring-1 ring-black/10" />
						<span>{currentLanguage.locale.toUpperCase()}</span>
						<span aria-hidden="true" class="text-[0.6rem] opacity-60">▾</span>
					</summary>
					<ul class="absolute right-0 mt-1.5 min-w-36 overflow-hidden rounded-lg border border-zinc-200 bg-white py-1 text-sm shadow-lg dark:border-zinc-700 dark:bg-zinc-900">
						{languages.map((lang) => (
							<li>
								<a
									href={languageHref(lang.href)}
									hreflang={lang.locale}
									lang={lang.locale}
									aria-current={lang.locale === locale ? 'page' : undefined}
									class:list={[
										'flex items-center gap-2.5 px-3 py-1.5 hover:bg-zinc-100 hover:text-indigo-600 dark:hover:bg-zinc-800 dark:hover:text-indigo-400',
										lang.locale === locale ? 'font-semibold text-indigo-600 dark:text-indigo-400' : 'text-zinc-700 dark:text-zinc-300',
									]}
								>
									<Flag locale={lang.locale} class="h-3.5 w-5 shrink-0 rounded-[2px] shadow-sm ring-1 ring-black/10" />
									{lang.name}
								</a>
							</li>
						))}
					</ul>
				</details>
				<button
					type="button"
					data-theme-toggle
					data-label-light="☀️"
					data-label-dark="🌙"
					class="clickable rounded-lg border border-zinc-200 px-2.5 py-1 text-sm dark:border-zinc-700"
					aria-label={ui.themeToggleLabel}
				></button>
			</div>
		</div>
	</div>

	<!-- Everything below the navbar is held in place while the projects carousel plays (see global.css) -->
	<div class="scroll-freeze" data-scroll-freeze>
		<div class="scroll-freeze-content">

			<!-- ── HERO ──────────────────────────────────────────── -->
			<header id="main-content" class="mx-auto max-w-5xl px-4 pb-8 pt-12 sm:px-6 sm:pb-10 sm:pt-16">
				<div class="flex items-start justify-between gap-6 reveal" data-reveal>
					<div class="min-w-0">
						<div class="inline-flex items-center gap-2 rounded-full border border-indigo-200 bg-indigo-50 px-3 py-1 text-xs font-semibold text-indigo-700 dark:border-indigo-800 dark:bg-indigo-950/60 dark:text-indigo-300">
							<span class="size-1.5 rounded-full bg-indigo-500"></span>
							<span data-typing>{c.header.tagline}</span>
						</div>
						<h1 class="mt-4 text-4xl font-extrabold leading-none tracking-tight sm:text-5xl lg:text-6xl">
							<span class="hero-gradient bg-gradient-to-br from-zinc-900 via-zinc-700 to-indigo-800 bg-clip-text text-transparent dark:from-white dark:via-zinc-200 dark:to-indigo-300">
								{c.header.name}
							</span>
						</h1>
						<p class="mt-4 max-w-2xl text-sm leading-relaxed text-zinc-600 sm:mt-5 sm:text-base dark:text-zinc-300">{c.header.summary}</p>
						<div class="mt-5 flex flex-wrap gap-2 sm:mt-7 sm:gap-3">
							<a
								href={c.header.ctaPrimary.href}
								class="cta-glow clickable inline-flex items-center gap-2 rounded-xl border border-indigo-600 bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 sm:px-5 sm:py-2.5"
							>
								{c.header.ctaPrimary.label} <span aria-hidden="true">→</span>
							</a>
							<a
								href={c.header.ctaSecondary.href}
								class="clickable inline-flex items-center gap-2 rounded-xl border border-zinc-300 px-4 py-2 text-sm font-semibold text-zinc-800 hover:text-indigo-700 sm:px-5 sm:py-2.5 dark:border-zinc-700 dark:text-zinc-200 dark:hover:text-indigo-300"
							>
								{c.header.ctaSecondary.label}
							</a>
						</div>
					</div>
					<div class="hidden shrink-0 sm:block">
						<div class="photo-frame tilt-card size-68 overflow-hidden rounded-2xl" data-tilt>
							<img
								src={import.meta.env.BASE_URL + 'images/Foto.jpg'}
								alt={ui.photoAlt}
								class="size-full object-cover"
								style="object-position: center 20%;"
							/>
						</div>
					</div>
				</div>
			</header>

			<main class="mx-auto max-w-5xl space-y-12 px-4 pb-20 sm:space-y-14 sm:px-6">

				<!-- ── ABOUT ─────────────────────────────────────── -->
				<section id={s.about.id} class="scroll-mt-24 reveal" data-reveal>
					<h2 class="flex items-center gap-3 text-xl font-bold tracking-tight text-zinc-900 dark:text-white">
						<span class="block h-6 w-1 rounded-full bg-indigo-500"></span>
						{s.about.title}
					</h2>
					<div class="mt-5 rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
						<ul class="space-y-3 text-zinc-700 dark:text-zinc-300 reveal-stagger" data-reveal>
							{s.about.bullets.map((b) => (
								<li class="flex gap-3">
									<span class="mt-1 shrink-0 text-indigo-500" aria-hidden="true">✦</span>
									<span class="leading-relaxed">{b}</span>
								</li>
							))}
						</ul>
					</div>
				</section>

				<div class="section-divider" aria-hidden="true"></div>

				<!-- ── RESEARCH ─────────────────────────────────── -->
				<section id={s.research.id} class="scroll-mt-24">
					<div class="reveal" data-reveal>
						<h2 class="flex items-center gap-3 text-xl font-bold tracking-tight text-zinc-900 dark:text-white">
							<span class="block h-6 w-1 rounded-full bg-indigo-500"></span>
							{s.research.title}
						</h2>
					</div>
					<div class="mt-5">
						{s.research.items.map((r, idx) => (
							<div class="relative flex gap-5 pb-8 last:pb-0 reveal" data-reveal>
								<div class="relative flex flex-col items-center">
									<div class="z-10 flex size-8 shrink-0 items-center justify-center rounded-full border-2 border-indigo-400 bg-white shadow-md dark:bg-zinc-950">
										<span class="size-2.5 rounded-full bg-indigo-500"></span>
									</div>
									{idx < s.research.items.length - 1 && (
										<div class="timeline-line mt-1 w-0.5 flex-1 bg-zinc-200 dark:bg-zinc-800" data-timeline-line></div>
									)}
								</div>
								<div class="min-w-0 flex-1 rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
									<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
										<p class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">{r.title}</p>
										<span class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-medium break-words text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">{r.period}</span>
									</div>
									<h3 class="mt-2 text-base font-bold leading-snug text-zinc-900 dark:text-white">{r.project}</h3>

									<p class="mt-3 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{r.description}</p>

									{r.citation && (
										<div class="mt-4 rounded-xl border border-indigo-100 bg-indigo-50/50 p-4 dark:border-indigo-900/40 dark:bg-indigo-950/20">
											<p class="text-xs font-bold uppercase tracking-wider text-indigo-600 dark:text-indigo-400">{ui.publication}</p>
											<p class="mt-2 text-sm leading-relaxed text-zinc-700 dark:text-zinc-300">
												{r.citation.authors}, “{r.citation.title},” in <cite>{r.citation.proceedings}</cite>, {r.citation.location}, {r.citation.year}, pp. {r.citation.pages}, doi: <a href={`https://doi.org/${r.citation.doi}`} target="_blank" rel="noreferrer" class="link-underline wrap-anywhere font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300">https://doi.org/{r.citation.doi}</a>.
											</p>
										</div>
									)}

									<div class="mt-5 grid gap-x-8 gap-y-4 sm:grid-cols-2">
										{r.labs.length > 0 && (
											<div class="space-y-2">
												<p class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-500">{ui.labs}</p>
												{r.labs.map((lab) => (
													<div class="flex items-center text-sm">
														<a href={lab.href} target="_blank" rel="noreferrer" class="link-underline font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300">
															{lab.name} ↗
														</a>
													</div>
												))}
											</div>
										)}

										<div class="space-y-2">
											<p class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-500">{ui.advisors}</p>
											{r.advisors.map((a) => (
												<div class="flex flex-wrap items-center gap-x-2 text-sm">
													{a.href ? (
														<a href={a.href} target="_blank" rel="noreferrer" class="link-underline font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300">
															{a.name} ↗
														</a>
													) : (
														<span class="font-medium text-zinc-900 dark:text-white">{a.name}</span>
													)}
													<span class="text-zinc-500 dark:text-zinc-500">— {a.role}</span>
												</div>
											))}
										</div>

										{r.coauthors && r.coauthors.length > 0 && (
											<div class="space-y-2">
												<p class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-500">{ui.coauthors}</p>
												{r.coauthors.map((a) => (
													<div class="flex flex-wrap items-center gap-x-2 text-sm">
														<span class="font-medium text-zinc-900 dark:text-white">{a.name}</span>
														<span class="text-zinc-500 dark:text-zinc-500">— {a.role}</span>
													</div>
												))}
											</div>
										)}

										{r.repository && (
											<div class="space-y-2">
												<p class="text-xs font-bold uppercase tracking-wider text-zinc-500 dark:text-zinc-500">{ui.repository}</p>
												<div class="flex items-center text-sm">
													<a href={r.repository.href} target="_blank" rel="noreferrer" class="link-underline wrap-anywhere font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300">
														{r.repository.name} ↗
													</a>
												</div>
											</div>
										)}
									</div>

									<div class="mt-5 flex flex-wrap gap-1.5">
										{r.tags.map((t) => (
											<span class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-medium text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">{t}</span>
										))}
									</div>
								</div>
							</div>
						))}
					</div>
				</section>

				<div class="section-divider" aria-hidden="true"></div>

				<!-- ── PROJECTS (horizontal carousel) ────────────────── -->
				<section id={s.projects.id} class="projects-section scroll-mt-24" data-projects>
					<div class="reveal" data-reveal>
						<h2 class="flex items-center gap-3 text-xl font-bold tracking-tight text-zinc-900 dark:text-white">
							<span class="block h-6 w-1 rounded-full bg-indigo-500"></span>
							{s.projects.title}
						</h2>
						<p class="mt-1 text-xs text-zinc-500 dark:text-zinc-500">{ui.projectsHint}</p>
					</div>

					<div class="projects-viewport mt-1" data-projects-viewport>
						<div class="projects-track" data-projects-track>
							{s.projects.items.map((p) => (
								<article class="project-card tilt-card clickable flex flex-col overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900" data-tilt>
									<div class="h-1 w-full bg-gradient-to-r from-indigo-500 to-violet-500"></div>
									<div class="flex flex-1 flex-col p-6">
										<h3 class="text-base font-bold text-zinc-900 dark:text-white">{p.title}</h3>
										<p class="mt-2 flex-1 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">{p.description}</p>
										<div class="mt-4 flex flex-wrap gap-1.5">
											{p.tags.map((t) => (
												<span class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-medium text-zinc-700 dark:bg-zinc-800 dark:text-zinc-300">{t}</span>
											))}
										</div>
										{p.links?.length ? (
											<div class="mt-4 flex flex-wrap gap-3 border-t border-zinc-100 pt-4 dark:border-zinc-800">
												{p.links.map((l) => (
													<a class="link-underline text-xs font-semibold text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300" href={l.href} target="_blank" rel="noreferrer">
														{l.label} ↗
													</a>
												))}
											</div>
										) : null}
									</div>
								</article>
							))}
						</div>
					</div>

					<div class="projects-controls flex items-center gap-3">
						<button type="button" data-projects-prev aria-label={ui.previousProject} class="clickable flex size-8 shrink-0 items-center justify-center rounded-full border border-zinc-200 bg-white text-zinc-500 enabled:hover:text-indigo-600 disabled:cursor-not-allowed disabled:opacity-30 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400 dark:enabled:hover:text-indigo-400">
							<Icon name="chevron-left" class="size-4" />
						</button>
						<div class="relative h-0.5 flex-1 rounded-full bg-zinc-200 dark:bg-zinc-800">
							<div class="projects-progress-bar" data-projects-progress></div>
						</div>
						<p class="text-xs tabular-nums text-zinc-400 dark:text-zinc-600">
							<span data-projects-counter>1</span> / {s.projects.items.length}
						</p>
						<button type="button" data-projects-next aria-label={ui.nextProject} class="clickable flex size-8 shrink-0 items-center justify-center rounded-full border border-zinc-200 bg-white text-zinc-500 enabled:hover:text-indigo-600 disabled:cursor-not-allowed disabled:opacity-30 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-400 dark:enabled:hover:text-indigo-400">
							<Icon name="chevron-right" class="size-4" />
						</button>
					</div>
				</section>

				<div class="section-divider" aria-hidden="true"></div>

				<!-- ── EXPERIENCE ────────────────────────────────── -->
				<section id={s.experience.id} class="scroll-mt-24">
					<div class="reveal" data-reveal>
						<h2 class="flex items-center gap-3 text-xl font-bold tracking-tight text-zinc-900 dark:text-white">
							<span class="block h-6 w-1 rounded-full bg-indigo-500"></span>
							{s.experience.title}
						</h2>
					</div>
					<div class="mt-5 two-col-layout">
						<!-- Sidebar -->
						<aside class="sticky-sidebar hidden lg:block reveal-left" data-reveal>
							<p class="section-title-pill">{ui.timeline}</p>
							<ul class="mt-2 space-y-2">
								{s.experience.items.map((item) => (
									<li>
										<a href={`#${experienceId(item.role)}`} class="link-underline-group block rounded-lg px-3 py-2 text-xs font-medium">
											<span class="link-underline font-semibold text-zinc-700 dark:text-zinc-300">{item.role.split(' ').slice(0, 3).join(' ')}</span>
											<span class="mt-0.5 block text-zinc-400 dark:text-zinc-600">{item.period.split('—')[0].trim()}</span>
										</a>
									</li>
								))}
							</ul>
						</aside>
						<!-- Main timeline -->
						<div>
							{s.experience.items.map((item, idx) => (
								<div id={experienceId(item.role)} class="relative flex scroll-mt-24 gap-5 pb-8 last:pb-0 reveal" data-reveal>
									<div class="relative flex flex-col items-center">
										<div class="z-10 flex size-8 shrink-0 items-center justify-center rounded-full border-2 border-indigo-400 bg-white shadow-md dark:bg-zinc-950">
											<span class="size-2.5 rounded-full bg-indigo-500"></span>
										</div>
										{idx < s.experience.items.length - 1 && (
											<div class="timeline-line mt-1 w-0.5 flex-1 bg-zinc-200 dark:bg-zinc-800" data-timeline-line></div>
										)}
									</div>
									<div class="min-w-0 flex-1 rounded-2xl border border-zinc-200 bg-white p-5 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
										<div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
											<h3 class="text-sm font-bold text-zinc-900 dark:text-white">{item.role}</h3>
											<span class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-medium break-words text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">{item.period}</span>
										</div>
										<p class="mt-1 text-sm font-semibold text-indigo-600 dark:text-indigo-400">{item.org}</p>
										<ul class="mt-3 space-y-1.5 text-sm text-zinc-600 dark:text-zinc-400">
											{item.highlights.map((h) => (
												<li class="flex gap-2">
													<span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-zinc-300 dark:bg-zinc-600"></span>
													<span>{h}</span>
												</li>
											))}
										</ul>
										{item.link && (
											<p class="mt-3 text-sm">
												<a href={item.link.href} class="link-underline font-medium text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300">
													{item.link.label} <span aria-hidden="true">→</span>
												</a>
											</p>
										)}
									</div>
								</div>
							))}
						</div>
					</div>
				</section>

				<div class="section-divider" aria-hidden="true"></div>

				<!-- ── EDUCATION ────────────────────────────────── -->
				<section id={s.education.id} class="scroll-mt-24">
					<div class="reveal" data-reveal>
						<h2 class="flex items-center gap-3 text-xl font-bold tracking-tight text-zinc-900 dark:text-white">
							<span class="block h-6 w-1 rounded-full bg-indigo-500"></span>
							{s.education.title}
						</h2>
					</div>
					<div class="mt-5 grid gap-4 sm:grid-cols-2 reveal-stagger" data-reveal>
						{s.education.items.map((e) => (
							<div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
								<div class="mb-3 flex size-10 items-center justify-center rounded-xl bg-indigo-100 text-lg dark:bg-indigo-950/50">
									🎓
								</div>
								<h3 class="text-sm font-bold text-zinc-900 dark:text-white">{e.program}</h3>
								<p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400">{e.school}</p>
								<p class="mt-3 inline-flex items-center rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-medium text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">{e.period}</p>
							</div>
						))}
					</div>
				</section>

				<div class="section-divider" aria-hidden="true"></div>

				<!-- ── CERTIFICATES ─────────────────────────────── -->
				<section id={s.certificates.id} class="scroll-mt-24">
					<div class="reveal" data-reveal>
						<h2 class="flex items-center gap-3 text-xl font-bold tracking-tight text-zinc-900 dark:text-white">
							<span class="block h-6 w-1 rounded-full bg-indigo-500"></span>
							{s.certificates.title}
						</h2>
						<p class="mt-1 text-xs text-zinc-500 dark:text-zinc-500">{ui.certificatesHint}</p>
					</div>

					<div class="h-carousel-wrap mt-1" data-hcarousel>
						<button type="button" data-hcarousel-prev aria-label={ui.previous} class="h-carousel-arrow is-prev clickable flex size-10 items-center justify-center rounded-full border border-zinc-200 bg-white text-zinc-600 shadow-md hover:text-indigo-600 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:text-indigo-400">
							<Icon name="chevron-left" class="size-5" />
						</button>
						<div class="h-carousel-track" tabindex="0" role="region" aria-label={s.certificates.title}>
							{s.certificates.items.map((item) => {
								const gallery = galleryOf(item);
								const [cover] = gallery;
								return (
									<div class="h-carousel-card">
										{cover ? (
											<a
												href={cover.src}
												class="tilt-card clickable group flex h-full flex-col overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900"
												data-tilt
												data-lightbox={lightboxOf(gallery)}
												data-lightbox-title={item.title}
												draggable="false"
											>
												<div class="relative overflow-hidden bg-zinc-50 dark:bg-zinc-800">
													<img src={cover.thumb} alt="" loading="lazy" draggable="false" class="h-36 w-full object-cover transition-transform duration-300 group-hover:scale-105" />
													<span class="absolute right-2 top-2 flex size-7 items-center justify-center rounded-full bg-zinc-900/60 text-white">
														<Icon name="expand" class="size-3.5" />
													</span>
												</div>
												<div class="flex flex-1 flex-col p-4">
													<h3 class="text-xs font-bold leading-snug text-zinc-900 dark:text-white">{item.title}</h3>
													{item.detail && <p class="mt-1 text-xs font-semibold text-indigo-600 dark:text-indigo-400">{item.detail}</p>}
													{gallery.length > 1 && <p class="mt-auto pt-3 text-xs text-zinc-400 dark:text-zinc-600">{gallery.length} {ui.images}</p>}
												</div>
											</a>
										) : (
											<div class="flex h-full flex-col overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
												<div class="flex h-20 items-center justify-center bg-gradient-to-br from-indigo-50 to-violet-50 text-3xl dark:from-indigo-950/30 dark:to-violet-950/30">🎓</div>
												<div class="flex flex-1 flex-col p-4">
													<h3 class="text-xs font-bold leading-snug text-zinc-900 dark:text-white">{item.title}</h3>
													{item.detail && <p class="mt-1 text-xs font-semibold text-indigo-600 dark:text-indigo-400">{item.detail}</p>}
												</div>
											</div>
										)}
									</div>
								);
							})}
						</div>
						<button type="button" data-hcarousel-next aria-label={ui.next} class="h-carousel-arrow is-next clickable flex size-10 items-center justify-center rounded-full border border-zinc-200 bg-white text-zinc-600 shadow-md hover:text-indigo-600 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-300 dark:hover:text-indigo-400">
							<Icon name="chevron-right" class="size-5" />
						</button>
					</div>
				</section>

				<div class="section-divider" aria-hidden="true"></div>

				<!-- ── ACHIEVEMENTS ────────────────────────────── -->
				<section id={s.achievements.id} class="scroll-mt-24">
					<div class="reveal" data-reveal>
						<h2 class="flex items-center gap-3 text-xl font-bold tracking-tight text-zinc-900 dark:text-white">
							<span class="block h-6 w-1 rounded-full bg-indigo-500"></span>
							{s.achievements.title}
						</h2>
					</div>
					<div class="mt-5 space-y-8">
						{s.achievements.groups.map((group) => (
							<div class="reveal" data-reveal>
								<div class="flex items-center gap-3">
									<span class="flex size-9 shrink-0 items-center justify-center rounded-xl bg-indigo-100 text-indigo-600 dark:bg-indigo-950/50 dark:text-indigo-300">
										<Icon name="award" class="size-5" />
									</span>
									<h3 class="text-sm font-bold text-zinc-800 dark:text-zinc-200">{group.title}</h3>
									<span class="h-px flex-1 bg-zinc-200 dark:bg-zinc-800" aria-hidden="true"></span>
									<span class="rounded-full bg-zinc-100 px-2.5 py-0.5 text-xs font-medium tabular-nums text-zinc-600 dark:bg-zinc-800 dark:text-zinc-400">{group.items.length}</span>
								</div>

								<!-- Items with a document open it in the lightbox; the others are plain rows -->
								<ul class="mt-4 grid gap-3 md:grid-cols-2">
									{group.items.map((a) => {
										const gallery = galleryOf(a);
										const [cover] = gallery;
										return (
											<li>
												{cover ? (
													<a
														href={cover.src}
														class="tilt-card clickable group flex h-full items-center gap-4 rounded-xl border border-zinc-200 bg-white p-3 shadow-sm dark:border-zinc-800 dark:bg-zinc-900"
														data-tilt
														data-lightbox={lightboxOf(gallery)}
														data-lightbox-title={a.title}
													>
														<span class="relative size-16 shrink-0 overflow-hidden rounded-lg bg-zinc-100 dark:bg-zinc-800">
															<img src={cover.thumb} alt="" loading="lazy" class="size-full object-cover transition-transform duration-300 group-hover:scale-110" />
														</span>
														<span class="min-w-0 flex-1">
															<span class="block text-sm font-semibold leading-snug text-zinc-900 dark:text-white">{a.title}</span>
															{a.detail && <span class="mt-1 block text-xs text-zinc-500 dark:text-zinc-400">{a.detail}</span>}
															{gallery.length > 1 && <span class="mt-1 block text-xs text-zinc-400 dark:text-zinc-600">{gallery.length} {ui.images}</span>}
														</span>
														<Icon name="expand" class="size-4 shrink-0 text-zinc-400 transition-colors group-hover:text-indigo-500 dark:text-zinc-500" />
													</a>
												) : (
													<div class="flex h-full items-center gap-4 rounded-xl border border-zinc-200 bg-white p-3 shadow-sm dark:border-zinc-800 dark:bg-zinc-900">
														<span class="flex size-16 shrink-0 items-center justify-center rounded-lg bg-indigo-50 text-indigo-500 dark:bg-indigo-950/40 dark:text-indigo-300">
															<Icon name="award" class="size-7" />
														</span>
														<span class="min-w-0 flex-1">
															<span class="block text-sm font-semibold leading-snug text-zinc-900 dark:text-white">{a.title}</span>
															{a.detail && <span class="mt-1 block text-xs text-zinc-500 dark:text-zinc-400">{a.detail}</span>}
														</span>
													</div>
												)}
												{a.fullText && (
													<details class="mt-2 px-1">
														<summary class="link-underline w-fit cursor-pointer list-none text-xs font-semibold text-indigo-600 hover:text-indigo-500 dark:text-indigo-400 dark:hover:text-indigo-300">{ui.read} ▸</summary>
														<p class="mt-2 whitespace-pre-line text-xs leading-relaxed text-zinc-600 dark:text-zinc-400">{a.fullText}</p>
													</details>
												)}
											</li>
										);
									})}
								</ul>
							</div>
						))}
					</div>
				</section>

				<div class="section-divider" aria-hidden="true"></div>

				<!-- ── CONTACT ──────────────────────────────────── -->
				<section id={s.contact.id} class="contact-card scroll-mt-24 rounded-2xl border border-indigo-100 p-6 shadow-sm sm:p-8 dark:border-indigo-900/40">
					<div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
						<div>
							<h2 class="flex items-center gap-3 text-xl font-bold tracking-tight text-zinc-900 dark:text-white">
								<span class="block h-6 w-1 rounded-full bg-indigo-500"></span>
								{s.contact.title}
							</h2>
							<p class="mt-2 flex items-center gap-1.5 text-sm text-zinc-600 dark:text-zinc-400">
								<Icon name="pin" class="size-4 shrink-0 text-indigo-500 dark:text-indigo-400" />
								{s.contact.locationLine}
							</p>
						</div>
						<ul class="flex flex-wrap gap-3">
							{s.contact.links.map((l) => (
								<li>
									<a
										class="clickable group relative flex size-12 items-center justify-center rounded-2xl border border-zinc-200 bg-white text-zinc-700 shadow-sm hover:text-indigo-600 dark:border-zinc-700 dark:bg-zinc-800 dark:text-zinc-200 dark:hover:text-indigo-300"
										href={l.href}
										aria-label={l.label}
										target={isExternal(l.href) ? '_blank' : undefined}
										rel={isExternal(l.href) ? 'noreferrer' : undefined}
									>
										<Icon name={l.icon} class="size-5" />
										<span class="pointer-events-none absolute bottom-full left-1/2 mb-2 -translate-x-1/2 translate-y-1 rounded-md bg-zinc-900 px-2 py-1 text-xs font-medium whitespace-nowrap text-white opacity-0 shadow-md transition group-hover:translate-y-0 group-hover:opacity-100 group-focus-visible:translate-y-0 group-focus-visible:opacity-100 dark:bg-zinc-100 dark:text-zinc-900 [@media(hover:none)]:hidden" aria-hidden="true">{l.label}</span>
									</a>
								</li>
							))}
						</ul>
					</div>
				</section>
			</main>

			<footer class="mx-auto max-w-5xl border-t border-zinc-200 px-6 py-8 dark:border-zinc-800">
				<p class="text-center text-xs text-zinc-500 dark:text-zinc-600">{c.footer.text}</p>
			</footer>

		</div>
	</div>

	<!-- ── LIGHTBOX (filled in by scripts/lightbox.ts) ───── -->
	<dialog class="lightbox m-auto w-[min(56rem,calc(100vw-2rem))] max-w-none rounded-2xl border border-zinc-200 bg-white p-0 shadow-2xl backdrop:bg-zinc-950/70 backdrop:backdrop-blur-sm dark:border-zinc-800 dark:bg-zinc-950 dark:backdrop:bg-zinc-950/80" data-lightbox-dialog aria-labelledby="lightbox-title">
		<div class="p-4">
			<div class="flex items-center justify-between gap-4">
				<p id="lightbox-title" class="text-sm font-semibold text-zinc-900 dark:text-zinc-100" data-lightbox-title></p>
				<div class="flex shrink-0 items-center gap-2">
					<span class="text-xs tabular-nums text-zinc-500 dark:text-zinc-400" data-lightbox-counter data-lightbox-gallery></span>
					<button type="button" data-lightbox-close autofocus class="clickable shrink-0 rounded-lg border border-zinc-200 px-3 py-1.5 text-xs font-medium text-zinc-700 hover:text-indigo-600 dark:border-zinc-700 dark:text-zinc-300 dark:hover:text-indigo-400">✕ {ui.close}</button>
				</div>
			</div>
			<div class="relative mt-4">
				<img data-lightbox-image alt="" class="max-h-[75vh] w-full rounded-xl border border-zinc-200 object-contain dark:border-zinc-800" />
				<button type="button" data-lightbox-prev data-lightbox-gallery aria-label={ui.previousImage} class="clickable absolute left-2 top-1/2 z-10 flex size-9 -translate-y-1/2 items-center justify-center rounded-full border border-zinc-200 bg-white/90 text-zinc-600 shadow-md hover:text-indigo-600 dark:border-zinc-700 dark:bg-zinc-900/90 dark:text-zinc-300 dark:hover:text-indigo-400">
					<Icon name="chevron-left" class="size-4" />
				</button>
				<button type="button" data-lightbox-next data-lightbox-gallery aria-label={ui.nextImage} class="clickable absolute right-2 top-1/2 z-10 flex size-9 -translate-y-1/2 items-center justify-center rounded-full border border-zinc-200 bg-white/90 text-zinc-600 shadow-md hover:text-indigo-600 dark:border-zinc-700 dark:bg-zinc-900/90 dark:text-zinc-300 dark:hover:text-indigo-400">
					<Icon name="chevron-right" class="size-4" />
				</button>
			</div>
		</div>
	</dialog>

	<!-- Visit statistics (GoatCounter: no cookies, no visible counter). Only the /pt/ and /en/
	     pages load it, so the language redirect at / doesn't count a second view. -->
	<script is:inline data-goatcounter="https://vinicius-trindade.goatcounter.com/count" async src="https://gc.zgo.at/count.js"></script>
</BaseLayout>

<script>
	import '../scripts/theme';
	import '../scripts/language-menu';
	import '../scripts/effects';
	import '../scripts/tilt';
	import '../scripts/carousel';
	import '../scripts/lightbox';
	import '../scripts/projects';
</script>
